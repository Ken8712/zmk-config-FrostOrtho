// エンコーダの &msc SCRL_UP/DOWN の速度（units/秒）。既定 10 では tap-ms=20 の
// 1ティック(16ms)あたり 0.16 unit → 整数化で 0 になり、何も送られない。
// 100 なら 1ティックで 1.6 → 1 unit = 1クリック 1ノッチ
// （R.conf で smooth scrolling を無効にしているので iPad / Windows とも同じ）。
// pointing.h の #ifndef より前に置く必要があるため、全 #include より先に書く。

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

#include <input/processors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

// AML クリックしたときにタイムアウトを延長
// 下の行をコメントアウトでAMLオフ
// &mkp_input_listener { input-processors = <&zip_temp_layer 6 10000>; };

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        screenshot: screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 7>,
                <&macro_press>,
                <&kp LEFT_WIN &kp LEFT_SHIFT &kp S>,
                <&macro_release>,
                <&kp LEFT_WIN &kp LEFT_SHIFT &kp S>;

            label = "SCREENSHOT";
        };

        hold_tap: hold_tap {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings = <&macro_param_1to1 &kt MACRO_PLACEHOLDER &macro_param_2to1 &kp MACRO_PLACEHOLDER &macro_param_1to1 &kt MACRO_PLACEHOLDER>;
            label = "HOLD_TAP";
        };

        tap_with_alt: tap_with_alt {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&kt LEFT_ALT &macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_press>,
                <&kt LEFT_ALT>;

            label = "TAP_WITH_ALT";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
        };

        // Kyemap Editor用

        scroll_up_down: behavior_sensor_rotate_mouse {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <20>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            label = "sensor_rotate_mouse_scroll";
        };

        vol_up_down: vol_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            bindings = <&kp C_VOL_DN>, <&kp C_VOL_UP>;
        };

        // DYA Studio用

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_DN>;
            ccw-binding = <&kp C_VOL_UP>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        ipad {
            bindings = <
&kp Q             &kp W             &kp E         &kp R             &kp T                         &kp Y        &kp U          &kp I      &kp O       &kp P
&kp A             &kp S             &kp D         &kp F             &kp G                         &kp H        &kp J          &kp K      &kp L       &mt LEFT_GUI MINUS
&mt LEFT_SHIFT Z  &kp X             &kp C         &kp V             &kp B                         &kp N        &kp M          &kp COMMA  &kp PERIOD  &mt LEFT_SHIFT SLASH
&kp LEFT_GUI      &kp LEFT_CONTROL  &kp LEFT_ALT  &lt 8 LANG_HANJA  &lt 2 SPACE  &lt 4 LANG1      &lt 1 ENTER  &kp BACKSPACE  &mkp MB1   &lt 4 F10   &lt 5 INTERNATIONAL_1
            >;

            sensor-bindings = <&scroll_up_down>, <&rsr_trans>;
        };

        layer_1 {
            bindings = <
&kp MINUS             &kp N7  &kp N8  &kp N9  &kp LS(SEMICOLON)              &kp EQUAL          &kp CARET         &kp PLUS         &kp ASTERISK     &kp LEFT_PARENTHESIS
&kp N0                &kp N4  &kp N5  &kp N6  &kp LS(DQT)                    &kp EXCLAMATION    &kp LEFT_BRACKET  &kp POUND        &kp DOLLAR       &kp PERCENT
&mt LEFT_SHIFT SLASH  &kp N1  &kp N2  &kp N3  &kp DOT                        &kp RIGHT_BRACKET  &kp BACKSLASH     &kp RIGHT_BRACE  &kp PIPE         &mt LCTRL INTERNATIONAL_1
&mt LEFT_GUI RBKT     &trans  &trans  &trans  &lt 2 SPACE        &trans      &trans             &kp LEFT_BRACE    &trans           &lt 2 LS(LG(S))  &kp LS(INTERNATIONAL_3)
            >;

            sensor-bindings = <&scroll_up_down>, <&rsr_trans>;
        };

        ipad_arrow_mouse {
            bindings = <
&kp ESCAPE            &kp LS(LA(TAB))  &kp UP_ARROW  &kp LA(TAB)  &kp LS(SQT)                &kp LG(R)        &hold_tap GLOBE LA(LEFT)  &hold_tap GLOBE LA(RIGHT)   &hold_tap GLOBE LEFT_ARROW  &hold_tap GLOBE RIGHT
&kp LG(LEFT)          &kp LEFT         &kp DOWN      &kp RIGHT    &kp LG(RIGHT)              &kp LG(F)        &mkp MB1                  &hold_tap GLOBE UP_ARROW    &mkp MB2                    &kp LS(NUMBER_9)
&mt LEFT_SHIFT LG(Z)  &kp LG(X)        &kp LG(C)     &kp LG(V)    &kp LG(A)                  &kp SEMICOLON    &kp LG(RIGHT_BRACKET)     &hold_tap GLOBE DOWN_ARROW  &kp LG(BACKSLASH)           &kp LS(LG(NUMBER_3))
&trans                &trans           &trans        &trans       &trans         &trans      &lt 1 BACKSPACE  &kp DELETE                &trans                      &kp LS(NUMBER_1)            &trans
            >;

            sensor-bindings = <&scroll_up_down>, <&rsr_trans>;
        };

        layer_3 {
            bindings = <
&kp ESCAPE      &trans          &kp UP_ARROW    &trans           &trans               &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp END              &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &trans          &trans          &trans           &trans               &trans  &trans  &trans  &trans  &trans
&trans          &trans          &trans          &trans           &trans   &trans      &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&scroll_up_down>, <&rsr_trans>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans              &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans              &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans              &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans      &trans        &trans        &trans        &trans        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&scroll_up_down>, <&rsr_trans>;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&scroll_up_down>, <&rsr_trans>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans              &trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans    &trans    &trans    &trans
            >;

            sensor-bindings = <&scroll_up_down>, <&rsr_trans>;
        };

        layer_7 {
            bindings = <
&kp LC(LS(LEFT))  &kp LC(LEFT)  &kp LS(UP_ARROW)  &kp LC(RIGHT)         &kp LS(LC(RIGHT))              &trans  &trans                    &trans                     &trans  &kp LG(W)
&kp LS(LG(LEFT))  &kp LS(LEFT)  &kp LS(DOWN)      &kp LS(RIGHT)         &kp LS(LG(RIGHT))              &trans  &hold_tap GLOBE LC(LEFT)  &hold_tap GLOBE LC(RIGHT)  &trans  &hold_tap GLOBE F
&trans            &trans        &trans            &hold_tap GLOBE INT3  &trans                         &trans  &trans                    &trans                     &trans  &hold_tap LEFT_WIN M
&trans            &trans        &trans            &trans                &trans             &trans      &trans  &trans                    &trans                     &trans  &trans
            >;

            sensor-bindings = <&scroll_up_down>, <&rsr_trans>;
        };

        layer_8 {
            bindings = <
&tap_with_alt Q  &tap_with_alt W  &tap_with_alt E  &tap_with_alt R  &tap_with_alt T              &tap_with_alt Y  &tap_with_alt U  &tap_with_alt I      &tap_with_alt O       &tap_with_alt P
&tap_with_alt A  &tap_with_alt S  &tap_with_alt D  &tap_with_alt F  &tap_with_alt F              &tap_with_alt H  &tap_with_alt J  &tap_with_alt K      &tap_with_alt L       &tap_with_alt MINUS
&tap_with_alt Z  &tap_with_alt X  &tap_with_alt C  &tap_with_alt V  &tap_with_alt B              &tap_with_alt N  &tap_with_alt M  &tap_with_alt COMMA  &tap_with_alt PERIOD  &tap_with_alt SLASH
&trans           &trans           &trans           &trans           &trans           &trans      &trans           &trans           &trans               &trans                &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        textselector_condition {
            if-layers = <2 1>;
            then-layer = <7>;
        };
    };
};
